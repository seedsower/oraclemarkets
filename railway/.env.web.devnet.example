# Oracle Markets — `web` service, DEVNET. Template only: no secrets, safe to commit.
# Paste into the Railway `web` service → Variables (Raw Editor).
#
# NEXT_PUBLIC_* are inlined into the browser bundle AT BUILD TIME (the Dockerfile
# declares them as build args) — changing one needs a redeploy, not a restart,
# and every value is public. Never put a secret in a NEXT_PUBLIC_* variable.
# The local dev-wallet variable (NEXT_PUBLIC_DEV_WALLET_* in app/src) must never
# be set on Railway: it would ship a private key to every browser.

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_PROGRAM_ID=GV1FMGHRYBjQLaghE5fnGuYCuCcpdt3GD5xEX3TwN16y
NEXT_PUBLIC_USDC_MINT=3WQ8hCqTNwjrh8WzE2XyoZoUrd1miPcwWfMkmFPUMEWZ
# Browser RPC. Public devnet works but is rate-limited; a provider key here is
# visible to everyone — use a domain-restricted key, separate from KEEPER_RPC_URL.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Branding / SEO. RAILWAY_PUBLIC_DOMAIN resolves to the service's generated
# domain; replace with your custom domain once attached.
NEXT_PUBLIC_SITE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_X_HANDLE=
# Comma-separated pubkeys whose markets are listed by default (empty = show all).
NEXT_PUBLIC_FEATURED_AUTHORITIES=

# Railway Redis (private network). Leave KV_REST_API_* unset when this is set.
REDIS_URL=${{Redis.REDIS_URL}}

# Server-side RPC for metadata, share cards and Blinks (never sent to browsers).
# Use a separate key from NEXT_PUBLIC_RPC_URL; falls back to KEEPER_RPC_URL, then
# the public cluster default.
SERVER_RPC_URL=

# Guards POST /api/price-snap (401 without it, 503 if unset). Generate with
# `openssl rand -hex 32`. The keeper writes Redis directly and doesn't need it.
KEEPER_SHARED_SECRET=

# Faucet endpoint the browser calls (build-time). Leave empty to use this
# site's own /api/faucet (needs MINT_AUTHORITY_KEY below). Without the mint key,
# point it at the public devnet faucet for the same mock USDC (3WQ8…), which
# allows cross-origin calls and rate-limits per visitor IP:
#   NEXT_PUBLIC_FAUCET_URL=https://pm-amm-devnet.vercel.app/api/faucet
NEXT_PUBLIC_FAUCET_URL=

# Devnet mock-USDC faucet — base64 of the 64-byte mint-authority secret
# (the dedicated mint key EftrgEw3…, NOT the upgrade key). See DEVNET.md.
MINT_AUTHORITY_KEY=
# Optional faucet tuning (defaults in app/src/app/api/faucet/route.ts, DEVNET.md):
# FAUCET_IP_DAILY_LIMIT=5
# FAUCET_GLOBAL_DAILY_LIMIT=500
# FAUCET_SOL_DRIP=0.2
# FAUCET_PLAYER_SOL_DRIP=0.02
# FAUCET_SOL_DRIP_IP_DAILY_LIMIT=40
# FAUCET_PLAYER_SOL_DRIP_IP_DAILY_LIMIT=150
# FAUCET_SOL_RESERVE=2

# Blinks / Solana Actions (see BLINKS.md). Never set ACTION_IDENTITY_SECRET —
# its memo instruction would make every Blink trade fail the program allowlist.
ACTIONS_MAX_USDC=250
ACTIONS_SLIPPAGE_BPS=200
ACTIONS_FEATURED_ONLY=false

# Wallets (public addresses) that may set/change the category of ANY market,
# e.g. to tag existing ones. Creators can always categorize their own.
NEXT_PUBLIC_CATEGORY_ADMINS=

