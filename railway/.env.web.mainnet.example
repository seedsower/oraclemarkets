# Oracle Markets — `web` service, MAINNET-BETA. Template only: no secrets, safe to commit.
# Paste into the Railway `web` service → Variables (Raw Editor), in a separate
# Railway environment (or project) from devnet.
#
# NEXT_PUBLIC_* are inlined into the browser bundle AT BUILD TIME and are public.
# The local dev-wallet variable (NEXT_PUBLIC_DEV_WALLET_* in app/src) must never
# be set on Railway: it would ship a private key to every browser.
#
# The faucet is DISABLED on mainnet (UI hidden, /api/faucet returns 503): real
# USDC has no mint authority. MINT_AUTHORITY_KEY is intentionally absent from
# this template — do not add it.

NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_PROGRAM_ID=GV1FMGHRYBjQLaghE5fnGuYCuCcpdt3GD5xEX3TwN16y
# Real USDC (Circle, 6 decimals).
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Dedicated mainnet RPC (Helius / Triton / QuickNode). The public endpoint will
# not hold up. This key ships to browsers: restrict it by domain, and give the
# keeper its own key (KEEPER_RPC_URL) — with the keeper cache, browsers mostly
# only read single accounts and send transactions.
NEXT_PUBLIC_RPC_URL=https://your-mainnet-rpc-endpoint-here

NEXT_PUBLIC_SITE_URL=https://your-custom-domain.example
NEXT_PUBLIC_X_HANDLE=
# Strongly recommended on mainnet: anyone can create markets on the shared program.
NEXT_PUBLIC_FEATURED_AUTHORITIES=

REDIS_URL=${{Redis.REDIS_URL}}

# Server-side RPC for metadata, share cards and Blinks (never sent to browsers).
# Use a separate key from NEXT_PUBLIC_RPC_URL; falls back to KEEPER_RPC_URL, then
# the public cluster default.
SERVER_RPC_URL=

# Guards POST /api/price-snap. Generate with `openssl rand -hex 32`.
KEEPER_SHARED_SECRET=
