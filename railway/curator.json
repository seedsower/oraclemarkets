{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/curator/Dockerfile",
    "watchPatterns": [
      "workers/curator/**",
      "packages/sdk/**",
      "pnpm-lock.yaml",
      "railway/curator.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER"
  }
}
