# Oracle Markets — `xbot` mention bot. Template only: no secrets, safe to commit.
# The bot replies to posts that mention it with market links. It never trades
# and holds no wallet. Get X_BOT_USER_ID + X_REFRESH_TOKEN by running, locally:
#   X_CLIENT_ID=… X_CLIENT_SECRET=… pnpm --filter @oracle-markets/xbot auth
# while logged into the bot account (see workers/xbot/README.md).

REDIS_URL=${{Redis.REDIS_URL}}

# OAuth 2.0 keys of the X app (Developer Portal → app → Keys and tokens).
X_CLIENT_ID=
X_CLIENT_SECRET=
# From the auth script. The bot rotates the refresh token and keeps the
# current one in Redis, so this value is only read on the first run.
X_REFRESH_TOKEN=
X_BOT_USER_ID=

XBOT_SITE_URL=https://oraclemarkets.app
XBOT_POLL_SECS=60
XBOT_DAILY_REPLY_CAP=100
# Stays true until you've watched the logs and are happy with the replies.
XBOT_DRY_RUN=true

# Featured markets ranked first in `markets` / `odds` (same list as the web).
XBOT_FEATURED_AUTHORITIES=

# Optional per-call prices (USD) for the daily cost estimate in the logs.
# XBOT_COST_PER_READ_USD=
# XBOT_COST_PER_POST_USD=
# XBOT_COST_PER_URL_POST_USD=
