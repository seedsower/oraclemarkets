# Oracle Markets — `xbot` mention bot. Template only: no secrets, safe to commit.
# The bot replies to posts that mention it with market links. It never trades
# and holds no wallet. Get X_BOT_USER_ID + X_REFRESH_TOKEN by running, locally:
#   X_CLIENT_ID=… X_CLIENT_SECRET=… pnpm --filter @oracle-markets/xbot auth
# while logged into the bot account (see workers/xbot/README.md).

REDIS_URL=${{Redis.REDIS_URL}}

# ── Option A (simplest): OAuth 1.0a keys from the developer portal ──────────
# Keys and tokens → "API Key and Secret" + "Access Token and Secret" (generate
# AFTER setting app permissions to Read and write). The bot posts as the
# account that owns the developer app. No browser step, no expiry. Check them
# first: X_API_KEY=… X_API_SECRET=… X_ACCESS_TOKEN=… X_ACCESS_SECRET=… npx tsx src/check.ts
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── Option B: OAuth 2.0 (any account, via the auth script) ─────────────────
# OAuth 2.0 keys of the X app (Developer Portal → app → Keys and tokens).
X_CLIENT_ID=
X_CLIENT_SECRET=
# From the auth script. The bot rotates the refresh token and keeps the
# current one in Redis, so this value is only read on the first run.
X_REFRESH_TOKEN=
# Optional: looked up automatically when unset.
X_BOT_USER_ID=

XBOT_SITE_URL=https://oraclemarkets.app
XBOT_POLL_SECS=60
XBOT_DAILY_REPLY_CAP=100
# Stays true until you've watched the logs and are happy with the replies.
XBOT_DRY_RUN=true

# Featured markets ranked first in `markets` / `odds` (same list as the web).
XBOT_FEATURED_AUTHORITIES=

# Optional per-call prices (USD) for the daily cost estimate in the logs.
# XBOT_COST_PER_READ_USD=
# XBOT_COST_PER_POST_USD=
# XBOT_COST_PER_URL_POST_USD=

# ── Bets from X ("bet? by <date>") — OFF unless both of these are set ──────
# A FRESH, dedicated hot wallet (base64 of its 64-byte secret). It pays rent to
# open bets and launches them when staking closes; it can NEVER resolve. Keep
# ~0.2 devnet SOL on it. Generate: solana-keygen new -o bot.json, then
#   node -e 'process.stdout.write(Buffer.from(JSON.parse(require("fs").readFileSync("bot.json"))).toString("base64"))'
XBOT_WALLET=
# The ONLY key that can resolve these bets: your admin wallet's PUBLIC key.
# Resolve in /admin → "Bets to resolve". Its secret never goes on Railway.
XBOT_BET_RESOLVER=
XBOT_RPC_URL=https://api.devnet.solana.com
# PROGRAM_ID / USDC_MINT default to the devnet deployment.
# Default staking window; a bet can choose its own: "bet? by Oct 20 in 30m" (15m..7d).
XBOT_BET_STAKE_HOURS=1
XBOT_BET_MIN_TOTAL_USDC=2
XBOT_BET_LP_BPS=5000
XBOT_BETS_PER_DAY=10
XBOT_BETS_PER_USER_PER_DAY=2
XBOT_MIN_SOL=0.05

