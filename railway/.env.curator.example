# Curator (workers/curator) — Railway service `curator`. Runs once and exits.
# Creates markets from oraclemarkets.io's top AI-forecast questions per category.
REDIS_URL=${{Redis.REDIS_URL}}
ANTHROPIC_API_KEY=${{xbot.ANTHROPIC_API_KEY}}
# Dedicated devnet key, base64 of the solana-keygen JSON file. It becomes the
# authority (= resolver + creator-fee recipient) of every curated market.
CURATOR_KEYPAIR=
# Seed for the partner sign-in (base64 of the login script's auth file). Used once:
# afterwards the rotating tokens live in Redis (curator:partner-auth).
PARTNER_MCP_AUTH_JSON=
RPC_URL=https://api.devnet.solana.com
# PROGRAM_ID / USDC_MINT default to the Oracle Markets devnet program and mock USDC.

# Safety (defaults shown)
CURATOR_DRY_RUN=true
CURATOR_MAX_NEW_PER_RUN=40
CURATOR_MAX_OPEN_SEED_USDC=3000
CURATOR_MIN_SOL=0.5
CURATOR_SOL_PER_MARKET=0.05
CURATOR_MAX_MCP_CALLS=500
PARTNER_MCP_MIN_INTERVAL_MS=500
# CURATOR_ALLOW_MAINNET=true   # refused otherwise (checked by genesis hash)
# After a live run that created markets, queue one summary post for the xbot
# (it posts it, unless XBOT_DRY_RUN). Off by default.
CURATOR_ANNOUNCE_ON_X=false

# Selection / creation (defaults shown)
CURATOR_TOP_N=10
CURATOR_MIN_DAYS=3
CURATOR_MAX_DAYS=120
CURATOR_MAX_FORECAST_AGE_HOURS=96
CURATOR_MIN_PROB=0.05
CURATOR_MAX_PROB=0.95
CURATOR_SEED_USDC=50
CURATOR_CLOSE_BUFFER_HOURS=24
# CURATOR_CATEGORIES=Politics,Finance,...   # default: all 12 partner categories
