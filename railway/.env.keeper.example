# Oracle Markets — `keeper` service. Template only: no secrets, safe to commit.
# Same variables for devnet and mainnet; only the RPC / mint values differ.
#
# The keeper holds NO upgrade, resolution, or mint key. The only optional key is
# KEEPER_KEYPAIR: a fresh, dedicated hot wallet with a small SOL balance and no
# authority over anything, used solely for the permissionless `accrue` call.

REDIS_URL=${{Redis.REDIS_URL}}

# Server-side RPC — its own key, separate from the browser's NEXT_PUBLIC_RPC_URL.
# Must allow getProgramAccounts (one call per list per interval).
KEEPER_RPC_URL=https://api.devnet.solana.com

PROGRAM_ID=GV1FMGHRYBjQLaghE5fnGuYCuCcpdt3GD5xEX3TwN16y
# devnet mock USDC; mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=3WQ8hCqTNwjrh8WzE2XyoZoUrd1miPcwWfMkmFPUMEWZ

KEEPER_INTERVAL_SECS=20

# Optional accrue loop (off unless both are set).
KEEPER_ACCRUE_ENABLED=false
# base64 of the 64-byte secret key of the dedicated keeper wallet, e.g.
#   solana-keygen new -o keeper.json && node -e 'process.stdout.write(Buffer.from(JSON.parse(require("fs").readFileSync("keeper.json"))).toString("base64"))'
KEEPER_KEYPAIR=
KEEPER_ACCRUE_EVERY_SECS=3600
KEEPER_PRIORITY_MICROLAMPORTS=5000
# Stop sending accrue transactions below this balance.
KEEPER_MIN_SOL=0.05

# KEEPER_DEBUG=true
