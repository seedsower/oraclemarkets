{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/xbot/Dockerfile",
    "watchPatterns": ["workers/xbot/**", "packages/sdk/**", "pnpm-lock.yaml", "railway/xbot.json"]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
